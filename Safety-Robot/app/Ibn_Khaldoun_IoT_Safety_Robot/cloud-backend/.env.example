# Safety Robot simulation API only — never place real facility secrets here.
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
SIMULATION_ONLY=true
OPERATOR_TOKENS=replace-with-development-only-token
MAX_TELEMETRY_AGE_MS=30000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Intentionally absent: broker credentials, GSM, WhatsApp, valve/motor topics,
# production device identities, or facility network endpoints.
